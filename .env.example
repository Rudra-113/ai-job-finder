# Optional. You can also save these on the Profile page.
# They stay on this computer. Leave them blank to skip free-text answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Grok uses the same style of API. Example only — use the model name from your xAI account:
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-4
# XAI_API_KEY=

# Port for the local page. The app listens on this computer only.
JOBAGENT_PORT=47321

# Google sign-in. Use a Web client. Redirect URI:
# http://127.0.0.1:47321/auth/google/callback
# Mailbox access is not requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
