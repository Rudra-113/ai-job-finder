# Copy the values you need into a local .env file. Do not commit .env.
# A variable already set in the environment is left as it is.

# Frontend (Netlify). Public Render URL, with no trailing slash.
# VITE_API_URL is accepted as the same setting.
API_URL=https://your-service.onrender.com

# Backend
PORT=47321
BIND_HOST=0.0.0.0
# Leave blank locally to use backend/data. Set this to the existing data folder
# when you want the saved profile, or to /var/data on Render.
DATA_DIR=
# Comma-separated site origins. No wildcard.
FRONTEND_ORIGIN=https://your-site.netlify.app
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
# production on Render. Leave blank for a local run.
APP_ENV=
# 1 makes Flask also serve the frontend folder. Use this for local testing.
SERVE_FRONTEND=
FLASK_DEBUG=

# Google sign-in for the hosted API. Create a Web client.
# Authorized redirect URI: https://your-service.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional answer API. The search does not need a key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
