# Optional. You can also save these on the Profile page.
# They stay on this computer. Leave them blank to skip free-text answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Grok uses the same style of API. Example only — use the model name from your xAI account:
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-4
# XAI_API_KEY=

# Port for the local page. This app never listens on a public address.
JOBAGENT_PORT=47321

# Set to 1 to hide the browser, or 0 to watch it.
# Windows shows the browser unless this is set.
JOBAGENT_HEADLESS=
